  "item": [
    {
      "name": "01 - Info API",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('database MongoDB', () => pm.expect(j.database).to.include('MongoDB'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/"
      },
      "response": []
    },
    {
      "name": "02 - Ambil Semua Kolam (+ meta)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('ada data dan meta', () => { pm.expect(j.data.length).to.be.above(0); pm.expect(j.meta.total).to.be.above(0); });",
              "pm.test('ikan embedded + pemilik populated', () => { pm.expect(j.data[0].ikan).to.be.an('array'); pm.expect(j.data[0].pemilik.nama).to.be.a('string'); });",
              "pm.collectionVariables.set('kolam_id', j.data[0]._id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/fish-ponds"
      },
      "response": []
    },
    {
      "name": "03 - Filtering jenisIkan=lele",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('tersaring hanya lele', () => { pm.expect(j.meta.total).to.eql(2); j.data.forEach(d => pm.expect(d.jenisIkan).to.eql('lele')); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/fish-ponds?jenisIkan=lele"
      },
      "response": []
    },
    {
      "name": "04 - Pagination page=2&limit=2",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('halaman 2 dari 2', () => { pm.expect(j.meta.page).to.eql(2); pm.expect(j.meta.totalPages).to.eql(2); pm.expect(j.data.length).to.be.at.most(2); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/fish-ponds?page=2&limit=2"
      },
      "response": []
    },
    {
      "name": "05 - Sorting jumlahBibit desc",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('urut turun', () => { for (let i = 1; i < j.data.length; i++) pm.expect(j.data[i-1].jumlahBibit).to.be.at.least(j.data[i].jumlahBibit); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/fish-ponds?sort=jumlahBibit&order=desc"
      },
      "response": []
    },
    {
      "name": "06 - Projection fields=kodeKolam,jenisIkan,jumlahBibit",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('hanya field yang dipilih', () => { pm.expect(j.data[0]).to.have.property('kodeKolam'); pm.expect(j.data[0]).to.not.have.property('pemilik'); pm.expect(j.data[0]).to.not.have.property('luasM2'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/fish-ponds?fields=kodeKolam,jenisIkan,jumlahBibit"
      },
      "response": []
    },
    {
      "name": "07 - Kombinasi 4 fitur",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('kombinasi bekerja', () => { pm.expect(j.data.length).to.eql(1); pm.expect(j.data[0].kodeKolam).to.eql('K-03'); pm.expect(j.data[0]).to.not.have.property('pemilik'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/fish-ponds?jenisIkan=lele&limit=1&sort=tanggalTebar&order=desc&fields=kodeKolam,jenisIkan,tanggalTebar"
      },
      "response": []
    },
    {
      "name": "08 - Detail + Pemilik (referencing)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('pemilik ikut terisi (populate)', () => { pm.expect(j.pemilik.nama).to.be.a('string'); pm.expect(j.ikan[0].namaIkan).to.be.a('string'); });",
              "pm.collectionVariables.set('pemilik_id', j.pemilik._id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/fish-ponds/{{kolam_id}}"
      },
      "response": []
    },
    {
      "name": "09 - Tambah Kolam (embedding + referencing)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('ikan tertanam + pemilik tertaut', () => { pm.expect(j.data.ikan[0].namaIkan).to.eql('Gurame Soang'); pm.expect(j.data.pemilik).to.be.a('string'); });",
              "pm.collectionVariables.set('kolam_baru_id', j.data._id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
